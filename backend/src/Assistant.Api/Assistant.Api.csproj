    <UserSecretsId>7ec0f297-49bb-4411-a436-ba4b15dfd172</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.11" />
